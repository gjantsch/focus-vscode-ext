{
  "compilerOptions": {
    "module": "commonjs",
    "target": "ES2020",
    "outDir": "./out",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "sourceMap": true,
    "lib": ["ES2020"],
    "paths": {
      "vscode": ["./src/test/mocks/vscode.ts"]
    },
    "baseUrl": "."
